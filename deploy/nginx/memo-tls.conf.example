# light-memo 站点配置（HTTPS 版，示例）
#
# 使用方式（详见 docs/DEPLOY-DOCKER.md 第 6 步）：
#   1. 拿到证书（certbot 签发到服务器 /etc/letsencrypt）
#   2. 把 server_name 全部替换为你的域名
#   3. 在 docker-compose.yml 的 web 服务里加两处：
#        ports:
#          - "80:80"
#          - "443:443"
#        volumes:
#          - /etc/letsencrypt:/etc/letsencrypt:ro
#   4. 本文件改名为 memo.conf 覆盖原文件，然后重新构建镜像（CI 会自动做）
#
# ⚠️ 为什么必须上 HTTPS？
# 后端登录 Cookie 是 Secure + HttpOnly + SameSite=Strict，
# 纯 HTTP 下浏览器会直接丢弃这个 Cookie，表现为"登录成功但一刷新就掉线"。

resolver 127.0.0.11 valid=30s ipv6=off;

# HTTP 全部跳转到 HTTPS（certbot 续期用的 /.well-known 除外）
server {
    listen 80;
    listen [::]:80;
    server_name example.com;          # ← 改成你的域名

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;          # ← 改成你的域名

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;   # ← 改
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;     # ← 改
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 256k;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;

    include /etc/nginx/memo/security-headers.conf;
    # 上了 HTTPS 再开 HSTS（先确认证书没问题，否则半年内浏览器强制跳 HTTPS 很难回退）
    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;

    location = /healthz {
        set $api_upstream "http://api:8080";
        proxy_pass $api_upstream$request_uri;
        include /etc/nginx/memo/proxy-params.conf;
    }

    location /api/ {
        set $api_upstream "http://api:8080";
        proxy_pass $api_upstream$request_uri;
        include /etc/nginx/memo/proxy-params.conf;
    }

    location /assets/ {
        include /etc/nginx/memo/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/memo/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
